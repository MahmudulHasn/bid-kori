# BidKori backend environment template
# Copy to `.env` and replace placeholders. Never commit real secrets.

# --- Required ---
# Generate a unique value, e.g.:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-me-with-a-unique-django-secret-key-at-least-50-chars-long

# --- Core ---
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---
# Leave unset (or commented) to use local SQLite (db.sqlite3).
# PostgreSQL (Docker Compose / remote):
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DB_NAME
# DATABASE_URL=

DB_CONN_MAX_AGE=600

# Docker Compose Postgres service (used when running `docker compose`)
POSTGRES_DB=bidkori
POSTGRES_USER=bidkori_user
POSTGRES_PASSWORD=change-me-local-only-password

# When using Compose web+db together, DATABASE_URL typically looks like:
# DATABASE_URL=postgres://bidkori_user:change-me-local-only-password@db:5432/bidkori

# --- CORS / CSRF (comma-separated, no wildcards) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=True
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Email (console backend is fine for local development) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@bidkori.local
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True

# --- Production HTTPS toggles (applied automatically when DEBUG=False) ---
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000

# --- Redis (Django Channels live bid broadcasts) ---
# Required for WebSocket group broadcasts outside the test suite.
# Local default / Docker Compose service name examples:
REDIS_URL=redis://127.0.0.1:6379/0
# Compose web service typically uses:
# REDIS_URL=redis://redis:6379/0

# --- Celery (automatic expired-auction closing) ---
# Broker/result default to Redis DB 1 derived from REDIS_URL when unset.
# Compose services should use the redis hostname (not 127.0.0.1):
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
# How often Beat enqueues close_expired_auctions_task (seconds). Default: 10.
CELERY_CLOSE_EXPIRED_INTERVAL_SECONDS=10
# Compose worker/beat typically use:
# CELERY_BROKER_URL=redis://redis:6379/1
# CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- Misc ---
TIME_ZONE=Asia/Dhaka
LOG_LEVEL=INFO

# --- Auction image uploads (optional overrides) ---
# AUCTION_IMAGE_MAX_BYTES=5242880
# AUCTION_IMAGE_MAX_WIDTH=4096
# AUCTION_IMAGE_MAX_HEIGHT=4096
# AUCTION_IMAGE_MAX_PER_AUCTION=10
# AUCTION_IMAGE_MAX_PER_REQUEST=5

# --- Product catalog images (optional overrides; max 5 per Product) ---
# PRODUCT_IMAGE_MAX_BYTES=5242880
# PRODUCT_IMAGE_MAX_COUNT=5
# PRODUCT_IMAGE_MAX_PER_REQUEST=5

# --- AI (backend-only; never NEXT_PUBLIC_*) ---
# Leave blank to boot Django without AI; AI endpoints return 503 when unset.
# AI_MODEL must support image input (listing drafts) via the OpenAI Responses API.
# AI_CHAT_MODEL should be a text-only chat model (support chatbot).
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=20
AI_LISTING_RATE=5/minute
AI_CHAT_MODEL=
AI_CHAT_RATE=10/minute

# --- Monetization (mock checkout accounting — not real gateway settlement) ---
# Seller-side successful-sale commission percent (0–100). Default 5.00.
# Snapshots are stored on Payment at checkout and are never recalculated
# when this value changes. Buyer pays winning amount only; fee reduces Seller net.
PLATFORM_SUCCESS_FEE_PERCENT=5.00
