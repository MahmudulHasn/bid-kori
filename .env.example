# BidKori backend environment template
# Copy to `.env` and replace placeholders. Never commit real secrets.

# --- Required ---
# Generate a unique value, e.g.:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-me-with-a-unique-django-secret-key-at-least-50-chars-long

# --- Core ---
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (PostgreSQL required) ---
# Authoritative for Django: DATABASE_URL (postgres:// or postgresql://).
# SQLite fallback is DISABLED. Host `manage.py` without DATABASE_URL will fail fast.
#
# Canonical development: run backend commands inside Compose (Option A):
#   docker compose exec web python manage.py …
# Compose injects DATABASE_URL pointing at service hostname `db` unless you override it.
#
# Optional host virtualenv against Compose Postgres (127.0.0.1:5432 published):
# DATABASE_URL=postgres://bidkori_user:change-me-local-only-password@127.0.0.1:5432/bidkori
#
# Explicit SQLite is ONLY for the Django test suite (never showcase/runtime):
# USE_SQLITE_FOR_TESTS=True

DB_CONN_MAX_AGE=600

# Compose Postgres service credentials (used to build default DATABASE_URL in compose)
POSTGRES_DB=bidkori
POSTGRES_USER=bidkori_user
POSTGRES_PASSWORD=change-me-local-only-password

# Changing POSTGRES_PASSWORD after the postgres_data volume exists requires a volume
# reset (`docker compose down -v`) or a manual ALTER ROLE — otherwise auth fails.

# --- CORS / CSRF (comma-separated, no wildcards) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=True
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Email (console backend is fine for local development) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@bidkori.local
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True

# --- Production HTTPS toggles (applied automatically when DEBUG=False) ---
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000

# --- Redis (Django Channels live bid broadcasts) ---
# Required for WebSocket group broadcasts outside the test suite.
REDIS_URL=redis://127.0.0.1:6379/0
# Compose web/worker/beat typically use:
# REDIS_URL=redis://redis:6379/0

# --- Celery (automatic expired-auction closing) ---
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
CELERY_CLOSE_EXPIRED_INTERVAL_SECONDS=10
# Compose worker/beat typically use:
# CELERY_BROKER_URL=redis://redis:6379/1
# CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- Misc ---
TIME_ZONE=Asia/Dhaka
LOG_LEVEL=INFO

# --- Auction image uploads (optional overrides) ---
# AUCTION_IMAGE_MAX_BYTES=5242880
# AUCTION_IMAGE_MAX_WIDTH=4096
# AUCTION_IMAGE_MAX_HEIGHT=4096
# AUCTION_IMAGE_MAX_PER_AUCTION=10
# AUCTION_IMAGE_MAX_PER_REQUEST=5

# --- Product catalog images (optional overrides; max 5 per Product) ---
# PRODUCT_IMAGE_MAX_BYTES=5242880
# PRODUCT_IMAGE_MAX_COUNT=5
# PRODUCT_IMAGE_MAX_PER_REQUEST=5

# --- AI (backend-only; never NEXT_PUBLIC_*) ---
# Leave blank to boot Django without AI; AI endpoints return 503 when unset.
# Showcase: set AI_API_KEY plus both models, then recreate Compose web (see README).
# AI_MODEL must support image input (listing drafts) via the OpenAI Responses API.
# AI_CHAT_MODEL should be a text-capable chat model (support chatbot).
# Recommended OpenAI Responses models (change only if your account requires it):
#   AI_MODEL=gpt-4o-mini
#   AI_CHAT_MODEL=gpt-4o-mini
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=20
AI_LISTING_RATE=5/minute
AI_LISTING_MAX_OUTPUT_TOKENS=450
AI_CHAT_MODEL=
AI_CHAT_RATE=10/minute
AI_CHAT_MAX_OUTPUT_TOKENS=400

# --- Monetization (mock checkout accounting — not real gateway settlement) ---
# Seller-side successful-sale commission percent (0–100). Default 5.00.
# Snapshots are stored on Payment at checkout and are never recalculated
# when this value changes. Buyer pays winning amount only; fee reduces Seller net.
PLATFORM_SUCCESS_FEE_PERCENT=5.00
