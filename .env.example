# BidKori backend environment template
# Copy to `.env` and replace placeholders. Never commit real secrets.

# --- Required ---
# Generate a unique value, e.g.:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-me-with-a-unique-django-secret-key-at-least-50-chars-long

# --- Core ---
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---
# Leave unset (or commented) to use local SQLite (db.sqlite3).
# PostgreSQL (Docker Compose / remote):
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DB_NAME
# DATABASE_URL=

DB_CONN_MAX_AGE=600

# Docker Compose Postgres service (used when running `docker compose`)
POSTGRES_DB=bidkori
POSTGRES_USER=bidkori_user
POSTGRES_PASSWORD=change-me-local-only-password

# When using Compose web+db together, DATABASE_URL typically looks like:
# DATABASE_URL=postgres://bidkori_user:change-me-local-only-password@db:5432/bidkori

# --- CORS / CSRF (comma-separated, no wildcards) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=True
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Email (console backend is fine for local development) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@bidkori.local
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True

# --- Production HTTPS toggles (applied automatically when DEBUG=False) ---
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000

# --- Misc ---
TIME_ZONE=Asia/Dhaka
LOG_LEVEL=INFO
