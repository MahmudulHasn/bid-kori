              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/auctions/{{auctionId}}/place-bid/",
            "description": "Place a bid on an active auction. Requires authentication. Sellers cannot bid on their own listings."
          },
          "response": []
